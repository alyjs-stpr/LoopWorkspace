@@ -18,1 +18,19 @@
-    private var viewModel: CGMStatusHUDViewModel!
+    private var viewModel: CGMStatusHUDViewModel!
+
+    // Native CGM status stays authoritative. This callback changes only
+    // presentation, never samples, warnings, or Loop's glucose calculations.
+    public var loKeyAttentionChanged: ((Bool) -> Void)?
+    private var loKeyPreviousAttention: Bool?
+
+    public var loKeyRequiresAttention: Bool {
+        loKeyHasActiveStatusNotice ||
+        viewModel.glucoseValueString == CGMStatusHUDViewModel.staleGlucoseRepresentation ||
+        viewModel.glucoseValueTintColor != UIColor.label
+    }
+
+    private func loKeyNotifyAttentionIfNeeded() {
+        let attention = loKeyRequiresAttention
+        guard attention != loKeyPreviousAttention else { return }
+        loKeyPreviousAttention = attention
+        loKeyAttentionChanged?(attention)
+    }
