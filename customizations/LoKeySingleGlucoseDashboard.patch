diff --git a/LoopUI/Views/StatusBarHUDView.swift b/LoopUI/Views/StatusBarHUDView.swift
--- a/LoopUI/Views/StatusBarHUDView.swift
+++ b/LoopUI/Views/StatusBarHUDView.swift
@@ -28,1 +28,25 @@
-    private let lokeyPumpLabel = UILabel()
+    private let lokeyPumpLabel = UILabel()
+    private var loKeyCompactDashboardMode = false
+
+    // On the Dashboard the full-width purple card is the primary glucose
+    // presentation. The native CGM HUD remains alive and becomes visible
+    // for stale readings, CGM warnings and status badges. Native loop and
+    // pump HUDs are always visible and retain their original tap actions.
+    public func setLoKeyCompactDashboardMode(_ enabled: Bool) {
+        loKeyCompactDashboardMode = enabled
+        cgmStatusHUD.loKeyAttentionChanged = { [weak self] _ in
+            self?.loKeyUpdateCompactHUD()
+        }
+        loKeyUpdateCompactHUD()
+    }
+
+    private func loKeyUpdateCompactHUD() {
+        guard containerView.arrangedSubviews.count == 3 else { return }
+        let cgmTile = containerView.arrangedSubviews[0]
+        cgmTile.isHidden = loKeyCompactDashboardMode && !cgmStatusHUD.loKeyRequiresAttention
+        lokeyGlucoseAgeLabel.isHidden = loKeyCompactDashboardMode
+        lokeyLoopAgeLabel.isHidden = loKeyCompactDashboardMode
+        lokeyPumpLabel.isHidden = loKeyCompactDashboardMode
+        containerView.distribution = .fillEqually
+        containerView.spacing = loKeyCompactDashboardMode ? 8 : (adjustViewsForNarrowDisplay ? 4 : 6)
+    }
