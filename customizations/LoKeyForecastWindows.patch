+        // Shared chart axis: one hour of actual history and the selected
+        // forward display horizon (1, 3 or 6 hours).
+        // Minute anchoring avoids a full axis rebuild for every CGM refresh;
+        // the most recent history window differs by less than one minute.
+        // Loop's glucose/insulin prediction calculations are not modified.
+        let anchor = Date(timeIntervalSince1970: floor(Date().timeIntervalSince1970 / 60) * 60)
+        let chartStartDate = anchor.addingTimeInterval(-TimeInterval(hours: 1))
+        let chartEndDate = anchor.addingTimeInterval(TimeInterval(hours: Double(lokeyForecastHours)))
+        if charts.startDate != chartStartDate {
+            refreshContext.formUnion(RefreshContext.all)
+        }
+        charts.startDate = chartStartDate
+        charts.maxEndDate = chartEndDate
+        charts.updateEndDate(chartEndDate)
