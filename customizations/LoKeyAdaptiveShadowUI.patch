+    private static let parkID = UUID(uuidString: "B2717255-F306-4B52-93DC-D416A93E4BE5")!
+
+    private var activeParkOverride: TemporaryScheduleOverride? {
+        guard let item = deviceManager.loopManager.settings.scheduleOverride,
+              item.isActive(at: Date()),
+              case .preset(let preset) = item.context,
+              preset.id == Self.parkID else { return nil }
+        return item
+    }
+
+    // Pausing removes only the park target override; the pump keeps operating.
+    // A persisted expiry prevents a paused park session from extending forever.
+    private var pausedParkSession: (low: Double, high: Double, end: Date)? {
+        let prefs = UserDefaults.standard
+        guard prefs.bool(forKey: "LoKeyParkPausedV1"),
+              let end = prefs.object(forKey: "LoKeyParkEndV1") as? Date,
+              end > Date(),
+              let low = prefs.object(forKey: "LoKeyParkLowV1") as? Double,
+              let high = prefs.object(forKey: "LoKeyParkHighV1") as? Double else { return nil }
+        return (low, high, end)
+    }
+
+    @objc private func loKeyExportAdaptiveShadow() {
+        let files = deviceManager.loKeyAdaptiveShadowFilesForExport()
+        guard !files.isEmpty else {
+            let alert = UIAlertController(
+                title: "No shadow records yet",
+                message: "Turn on Adaptive Shadow and allow Loop to complete a cycle, then try again.",
+                preferredStyle: .alert
+            )
+            alert.addAction(UIAlertAction(title: "OK", style: .default))
+            present(alert, animated: true)
+            return
+        }
+        let sheet = UIActivityViewController(activityItems: files, applicationActivities: nil)
+        sheet.popoverPresentationController?.sourceView = view
+        present(sheet, animated: true)
+    }
+
+    @objc private func presentParkMode() {
+        let item = activeParkOverride
+        let paused = pausedParkSession
+        let prefs = UserDefaults.standard
+        let currentOverride = deviceManager.loopManager.settings.scheduleOverride
+        let otherOverrideActive = item == nil && (currentOverride?.isActive(at: Date()) ?? false)
+        let suspend = deviceManager.loopManager.settings.suspendThreshold?.quantity.doubleValue(for: .milligramsPerDeciliter) ?? 0
+        let minAllowed = max(Guardrail.correctionRange.absoluteBounds.lowerBound.doubleValue(for: .milligramsPerDeciliter), suspend)
+        let panel = LoKeyThemeParkView(
+            active: item != nil, paused: paused != nil, canActivate: !otherOverrideActive,
+            minAllowed: minAllowed,
+            low: item?.settings.targetRange?.lowerBound.doubleValue(for: .milligramsPerDeciliter)
+                ?? paused?.low ?? (prefs.object(forKey: "LoKeyParkLowV1") as? Double),
+            high: item?.settings.targetRange?.upperBound.doubleValue(for: .milligramsPerDeciliter)
+                ?? paused?.high ?? (prefs.object(forKey: "LoKeyParkHighV1") as? Double),
+            until: item?.scheduledEndDate ?? paused?.end,
+            start: { [weak self] a, b, end in
+                guard let self else { return false }
+                let now = Date()
+                let seconds = end.timeIntervalSince(now)
+                let unrelatedActive = self.activeParkOverride == nil &&
+                    (self.deviceManager.loopManager.settings.scheduleOverride?.isActive(at: now) ?? false)
+                guard !unrelatedActive, seconds >= 15 * 60, seconds <= 24 * 3600,
+                      a >= minAllowed, b <= 250, a <= b else { return false }
+                let settings = TemporaryScheduleOverrideSettings(
+                    unit: .milligramsPerDeciliter, targetRange: DoubleRange(minValue: a, maxValue: b))
+                let preset = TemporaryScheduleOverridePreset(
+                    id: Self.parkID, symbol: "🎢", name: "Theme Park",
+                    settings: settings, duration: .finite(seconds))
+                prefs.set(a, forKey: "LoKeyParkLowV1")
+                prefs.set(b, forKey: "LoKeyParkHighV1")
+                prefs.set(end, forKey: "LoKeyParkEndV1")
+                prefs.set(false, forKey: "LoKeyParkPausedV1")
+                self.deviceManager.loopManager.mutateSettings { settings in
+                    settings.scheduleOverride = preset.createOverride(enactTrigger: .local, beginningAt: now)
+                }
+                self.updateParkDashboardHeader()
+                return true
+            },
+            pause: { [weak self] in
+                guard let self, let park = self.activeParkOverride,
+                      let range = park.settings.targetRange else { return }
+                prefs.set(range.lowerBound.doubleValue(for: .milligramsPerDeciliter), forKey: "LoKeyParkLowV1")
+                prefs.set(range.upperBound.doubleValue(for: .milligramsPerDeciliter), forKey: "LoKeyParkHighV1")
+                prefs.set(park.scheduledEndDate, forKey: "LoKeyParkEndV1")
+                self.deviceManager.loopManager.mutateSettings { settings in
+                    guard case .preset(let preset)? = settings.scheduleOverride?.context,
+                          preset.id == Self.parkID else { return }
+                    settings.clearOverride()
+                }
+                prefs.set(true, forKey: "LoKeyParkPausedV1")
+                self.updateParkDashboardHeader()
+            },
+            stop: { [weak self] in
+                guard let self else { return }
+                prefs.set(false, forKey: "LoKeyParkPausedV1")
+                if self.activeParkOverride != nil {
+                    self.deviceManager.loopManager.mutateSettings { settings in
+                        guard case .preset(let preset)? = settings.scheduleOverride?.context,
+                              preset.id == Self.parkID else { return }
+                        settings.clearOverride()
+                    }
+                }
+                self.updateParkDashboardHeader()
+            },
+            announceMeal: { [weak self] in
+                self?.dismiss(animated: true) { [weak self] in
+                    self?.userTappedAddCarbs()
+                }
+            },
+            shareShadow: { [weak self] in
+                self?.dismiss(animated: true) { [weak self] in
+                    self?.loKeyExportAdaptiveShadow()
+                }
+            })
+        present(UIHostingController(rootView: panel), animated: true)
+    }
