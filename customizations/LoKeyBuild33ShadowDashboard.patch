+private enum LoKeyShadowRecordReader {
+    struct Result: Sendable {
+        let cycles: [LoKeyAdaptive.RecordedCycle]
+        let unreadableLines: Int
+        let filesFound: Int
+    }
+
+    static func readRecent() -> Result {
+        let manager = FileManager.default
+        guard let root = manager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return Result(cycles: [], unreadableLines: 0, filesFound: 0)
+        }
+        let directory = root.appendingPathComponent("LoKeyAdaptiveShadow", isDirectory: true)
+        let files = ((try? manager.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)) ?? [])
+            .filter { $0.lastPathComponent.hasPrefix("adaptive-shadow-") && $0.pathExtension == "jsonl" }
+            .sorted { $0.lastPathComponent > $1.lastPathComponent }
+
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        decoder.nonConformingFloatDecodingStrategy =
+            .convertFromString(positiveInfinity: "Infinity", negativeInfinity: "-Infinity", nan: "NaN")
+
+        var cycles: [LoKeyAdaptive.RecordedCycle] = []
+        var unreadableLines = 0
+        for file in files.prefix(14) {
+            guard let data = try? Data(contentsOf: file, options: .mappedIfSafe),
+                  let text = String(data: data, encoding: .utf8) else {
+                unreadableLines += 1
+                continue
+            }
+            for line in text.split(whereSeparator: \.isNewline).reversed() {
+                if let cycle = try? decoder.decode(LoKeyAdaptive.RecordedCycle.self, from: Data(line.utf8)) {
+                    cycles.append(cycle)
+                } else {
+                    unreadableLines += 1
+                }
+                if cycles.count >= 240 { break }
+            }
+            if cycles.count >= 240 { break }
+        }
+        cycles.sort { $0.snapshot.observedAt > $1.snapshot.observedAt }
+        return Result(cycles: cycles, unreadableLines: unreadableLines, filesFound: files.count)
+    }
+
+    static func status(_ blocker: LoKeyAdaptive.Blocker?) -> String {
+        guard let blocker else { return "Hypothetical target evaluated (not applied)" }
+        switch blocker {
+        case .inactiveParkMode: return "Recorded · Theme Park inactive"
+        case .automaticDosingOff: return "Recorded · Automatic dosing off"
+        case .invalidTarget: return "Recorded · Invalid target range"
+        case .staleOrMissingCGM: return "Recorded · Missing or stale CGM"
+        case .staleOrMissingLoop: return "Recorded · Missing or stale Loop cycle"
+        case .insulinHistoryUnreconciled: return "Recorded · Dose history not reconciled"
+        case .uncertainDelivery: return "Recorded · Delivery uncertainty"
+        case .missingOrInvalidIOB: return "Recorded · IOB unavailable"
+        case .insufficientForecast: return "Recorded · Incomplete forecast"
+        case .invalidForecast: return "Recorded · Invalid forecast"
+        }
+    }
+
+    static func explanation(_ blocker: LoKeyAdaptive.Blocker?) -> String {
+        guard let blocker else {
+            return "Shadow calculated a hypothetical target. Normal Loop did not apply it."
+        }
+        if blocker == .inactiveParkMode {
+            return "Data collection is active, but the current target experiment only evaluates while Theme Park Mode is active. This normal-use cycle was recorded without calculating a hypothetical target."
+        }
+        return status(blocker) + ". No hypothetical target was calculated for this cycle."
+    }
+}
