+private struct LoKeyShadowCycleDetailView: View {
+    let cycle: LoKeyAdaptive.RecordedCycle
+
+    var body: some View {
+        List {
+            Section(header: Text("Recorded cycle")) {
+                Text(cycle.snapshot.observedAt.formatted(date: .abbreviated, time: .standard))
+                Text(LoKeyShadowRecordReader.explanation(cycle.evaluation.blocker))
+                    .font(.footnote).foregroundColor(.secondary)
+                if let target = cycle.evaluation.shadowTargetMgDl {
+                    line("Hypothetical target", number(target, suffix: " mg/dL"))
+                    Text("Not an applied correction target or insulin instruction.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+            }
+            Section(header: Text("Loop measurements")) {
+                line("Glucose", number(cycle.snapshot.latestGlucose?.glucoseMgDl, suffix: " mg/dL"))
+                line("IOB", number(cycle.snapshot.recordedIOBUnits, digits: 2, suffix: " U"))
+                line("COB", number(cycle.snapshot.carbsOnBoardGrams, suffix: " g"))
+                line("Loop bolus recommendation", number(cycle.snapshot.recommendedAutomaticBolusUnits, digits: 2, suffix: " U"))
+                line("Dose history reconciled", cycle.snapshot.insulinHistoryReconciled ? "Reported" : "Not confirmed")
+                line("Pump delivery certainty", cycle.snapshot.deliveryCertainty.rawValue)
+                line("Theme Park active", cycle.snapshot.parkModeActive ? "Yes" : "No")
+                line("Automatic dosing enabled", cycle.snapshot.automaticDosingEnabled ? "Yes" : "No")
+                if cycle.snapshot.target.isValid {
+                    line("Recorded target", "\(number(cycle.snapshot.target.lowMgDl))–\(number(cycle.snapshot.target.highMgDl)) mg/dL")
+                }
+            }
+            Section(header: Text("Loop forecast samples")) {
+                if cycle.snapshot.predictedGlucose.isEmpty {
+                    Text("None recorded")
+                }
+                ForEach(0..<min(cycle.snapshot.predictedGlucose.count, 24), id: \.self) { index in
+                    let sample = cycle.snapshot.predictedGlucose[index]
+                    line(sample.timestamp.formatted(date: .omitted, time: .shortened),
+                         number(sample.glucoseMgDl, suffix: " mg/dL"))
+                }
+            }
+            Section(header: Text("Recent dose history")) {
+                if cycle.snapshot.recordedDoseEvents.isEmpty {
+                    Text("No dose events recorded")
+                }
+                ForEach(0..<min(cycle.snapshot.recordedDoseEvents.count, 30), id: \.self) { index in
+                    let dose = cycle.snapshot.recordedDoseEvents[index]
+                    VStack(alignment: .leading, spacing: 4) {
+                        Text("\(dose.type) · \(dose.timestamp.formatted(date: .omitted, time: .shortened))")
+                        Text("Programmed: \(number(dose.programmedUnits, digits: 2)) U · Delivered: \(number(dose.deliveredUnits, digits: 2)) U")
+                            .font(.caption).foregroundColor(.secondary)
+                    }
+                }
+                Text("Programmed insulin is not proof of delivery. Missing values appear as unavailable.")
+                    .font(.caption).foregroundColor(.secondary)
+            }
+        }
+        .navigationTitle("Shadow Cycle")
+        .navigationBarTitleDisplayMode(.inline)
+    }
+
+    private func line(_ label: String, _ detail: String) -> some View {
+        HStack {
+            Text(label)
+            Spacer()
+            Text(detail).foregroundColor(.secondary).monospacedDigit()
+        }
+    }
+
+    private func number(_ value: Double?, digits: Int = 0, suffix: String = "") -> String {
+        guard let value, value.isFinite else { return "Unavailable" }
+        return String(format: "%.*f", digits, value) + suffix
+    }
+}
