+private struct LoKeyShadowDashboardView: View {
+    @AppStorage("LoKeyAdaptiveShadowEnabledV1") private var shadowEnabled = false
+    @State private var cycles: [LoKeyAdaptive.RecordedCycle] = []
+    @State private var isLoading = true
+    @State private var unreadableLines = 0
+    @State private var filesFound = 0
+    @State private var refreshedAt: Date?
+
+    var body: some View {
+        List {
+            Section(header: Text("Recording status")) {
+                HStack {
+                    Label("Adaptive Shadow", systemImage: "eye")
+                    Spacer()
+                    Text(shadowEnabled ? "On" : "Off")
+                        .foregroundColor(shadowEnabled ? .green : .secondary)
+                }
+                Text("This is historical observation data, not a live glucose display or an insulin dosing recommendation.")
+                    .font(.footnote).foregroundColor(.secondary)
+                Button("Refresh records") { Task { await reload() } }
+                    .disabled(isLoading)
+                if isLoading {
+                    ProgressView("Reading local records")
+                }
+                if let refreshedAt {
+                    Text("Last refreshed: \(refreshedAt.formatted(date: .abbreviated, time: .shortened))")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+            }
+
+            if let latest = cycles.first {
+                Section(header: Text("Latest recorded cycle")) {
+                    Text(latest.snapshot.observedAt.formatted(date: .abbreviated, time: .shortened))
+                        .font(.headline)
+                    if Date().timeIntervalSince(latest.snapshot.observedAt) > 15 * 60 {
+                        Label("Historical data; not a current reading", systemImage: "clock")
+                            .font(.footnote).foregroundColor(.secondary)
+                    }
+                    metric("Glucose", number(latest.snapshot.latestGlucose?.glucoseMgDl, suffix: " mg/dL"))
+                    metric("IOB", number(latest.snapshot.recordedIOBUnits, digits: 2, suffix: " U"))
+                    metric("COB", number(latest.snapshot.carbsOnBoardGrams, suffix: " g"))
+                    metric("Loop forecast samples", "\(latest.snapshot.predictedGlucose.count)")
+                    metric("Recent dose events", "\(latest.snapshot.recordedDoseEvents.count)")
+                    if let lower = latest.evaluation.predictionMinimumMgDl,
+                       let upper = latest.evaluation.predictionMaximumMgDl {
+                        metric("Predicted range", "\(number(lower))–\(number(upper)) mg/dL")
+                    }
+                    if let hypotheticalTarget = latest.evaluation.shadowTargetMgDl {
+                        metric("Hypothetical target", number(hypotheticalTarget, suffix: " mg/dL"))
+                    }
+                    Text(LoKeyShadowRecordReader.explanation(latest.evaluation.blocker))
+                        .font(.footnote).foregroundColor(.secondary)
+                }
+
+                Section(header: Text("Recent cycle history")) {
+                    Text("Showing \(cycles.count) recent readable cycles. Select a record to see the captured data.")
+                        .font(.footnote).foregroundColor(.secondary)
+                    ForEach(0..<min(cycles.count, 40), id: \.self) { index in
+                        let cycle = cycles[index]
+                        NavigationLink(destination: LoKeyShadowCycleDetailView(cycle: cycle)) {
+                            VStack(alignment: .leading, spacing: 4) {
+                                Text(cycle.snapshot.observedAt.formatted(date: .abbreviated, time: .shortened))
+                                Text(LoKeyShadowRecordReader.status(cycle.evaluation.blocker))
+                                    .font(.caption).foregroundColor(.secondary)
+                            }
+                        }
+                    }
+                }
+            } else if !isLoading {
+                Section {
+                    Text(filesFound == 0
+                         ? "No Shadow records saved yet. Allow Loop to complete a cycle with recording enabled."
+                         : "Files were found, but no readable Shadow records could be displayed.")
+                        .foregroundColor(.secondary)
+                }
+            }
+            if unreadableLines > 0 {
+                Section {
+                    Text("\(unreadableLines) unreadable record lines were skipped. The original files remain available through Export Shadow Records.")
+                        .font(.footnote).foregroundColor(.secondary)
+                }
+            }
+        }
+        .navigationTitle("Shadow Dashboard")
+        .navigationBarTitleDisplayMode(.inline)
+        .task { await reload() }
+    }
+
+    private func metric(_ label: String, _ detail: String) -> some View {
+        HStack {
+            Text(label)
+            Spacer()
+            Text(detail).foregroundColor(.secondary).monospacedDigit()
+        }
+    }
+
+    private func number(_ value: Double?, digits: Int = 0, suffix: String = "") -> String {
+        guard let value, value.isFinite else { return "Unavailable" }
+        return String(format: "%.*f", digits, value) + suffix
+    }
+
+    @MainActor private func reload() async {
+        isLoading = true
+        let result = await Task.detached(priority: .utility) {
+            LoKeyShadowRecordReader.readRecent()
+        }.value
+        cycles = result.cycles
+        unreadableLines = result.unreadableLines
+        filesFound = result.filesFound
+        refreshedAt = Date()
+        isLoading = false
+    }
+}
