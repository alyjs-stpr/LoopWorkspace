+    private func lokeyPredicted(_ minutes: Int, values: [GlucoseValue], unit: HKUnit) -> String {
+        let time = Date().addingTimeInterval(TimeInterval(minutes * 60))
+        guard let point = values.min(by: {
+            abs($0.startDate.timeIntervalSince(time)) < abs($1.startDate.timeIntervalSince(time))
+        }), abs(point.startDate.timeIntervalSince(time)) <= 180 else {
+            return "—"
+        }
+        return String(format: unit == .milligramsPerDeciliter ? "%.0f" : "%.1f",
+                      point.quantity.doubleValue(for: unit))
+    }
