+    // LoKey T1D: read-only values shown above the existing four charts.
+    private var lokeyFreshness = "CGM: —"
+    private var lokeyForecast = "Forecast 30 min: —  ·  60 min: —"
+    private var lokeyBasal: Double?
+    private var lokeyRecentBolus: DoseEntry?
+
+    private func lokeyPredictedValue(_ minutes: Int, values: [GlucoseValue], unit: HKUnit) -> String {
+        let target = Date().addingTimeInterval(TimeInterval(minutes * 60))
+        // Never extrapolate, and never label a far-away sample as an exact forecast.
+        guard let point = values.min(by: {
+            abs($0.startDate.timeIntervalSince(target)) < abs($1.startDate.timeIntervalSince(target))
+        }), abs(point.startDate.timeIntervalSince(target)) <= 180 else {
+            return "—"
+        }
+        return String(format: unit == .milligramsPerDeciliter ? "%.0f" : "%.1f",
+                      point.quantity.doubleValue(for: unit))
+    }
+
+    private func configureLoKeyInsightCell(_ cell: UITableViewCell) {
+        var config = cell.defaultContentConfiguration()
+        config.text = NSLocalizedString("AT A GLANCE", comment: "LoKey dashboard summary")
+        config.textProperties.font = .preferredFont(forTextStyle: .headline)
+        config.textProperties.color = UIColor { traits in
+            traits.userInterfaceStyle == .dark
+                ? UIColor(red: 0.7490, green: 0.5961, blue: 1, alpha: 1)
+                : UIColor(red: 0.5020, green: 0.1725, blue: 0.9255, alpha: 1)
+        }
+        let basalText = lokeyBasal.map { String(format: "%+.2f U/hr", $0) } ?? "—"
+        let bolusText: String
+        if let dose = lokeyRecentBolus {
+            let time = DateFormatter.localizedString(from: dose.startDate, dateStyle: .none, timeStyle: .short)
+            if let delivered = dose.deliveredUnits {
+                bolusText = String(format: "%.2f U delivered at %@", delivered, time)
+            } else {
+                bolusText = String(format: "%.2f U programmed at %@", dose.programmedUnits, time)
+            }
+        } else {
+            bolusText = "—"
+        }
+        config.secondaryText = [
+            lokeyFreshness,
+            lokeyForecast,
+            "Net basal: \(basalText)",
+            "Recent bolus: \(bolusText)",
+            NSLocalizedString("Forecasts are estimates, not sensor readings.", comment: "LoKey forecast disclaimer")
+        ].joined(separator: "\n")
+        config.secondaryTextProperties.numberOfLines = 0
+        config.secondaryTextProperties.font = .preferredFont(forTextStyle: .subheadline)
+        config.secondaryTextProperties.color = .label
+        cell.contentConfiguration = config
+        var background = UIBackgroundConfiguration.listGroupedCell()
+        background.backgroundColor = .tertiarySystemBackground
+        background.cornerRadius = 12
+        background.backgroundInsets = NSDirectionalEdgeInsets(top: 5, leading: 12, bottom: 5, trailing: 12)
+        cell.backgroundConfiguration = background
+        cell.selectionStyle = .none
+        cell.isAccessibilityElement = true
+        cell.accessibilityLabel = config.secondaryText
+    }
 
