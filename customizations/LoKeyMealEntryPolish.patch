+    static func suggested(for date: Date) -> LoKeyMealKind {
+        switch Calendar.current.component(.hour, from: date) {
+        case 5..<11: return .breakfast
+        case 11..<16: return .lunch
+        case 16..<22: return .dinner
+        default: return .snack
+        }
