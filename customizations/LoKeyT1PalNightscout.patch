+
+final class T1PalAuthenticationFallbackTestCase: XCTestCase {
+
+    func testT1PalServerErrorAllowsOnboarding() {
+        let siteURL = URL(string: "https://my.own.t1pal.com")!
+        let error = NightscoutError.httpError(status: 500, body: "Internal Server Error")
+
+        XCTAssertTrue(shouldUseT1PalAuthenticationFallback(siteURL: siteURL, error: error))
+    }
+
+    func testNonT1PalServerErrorDoesNotUseFallback() {
+        let siteURL = URL(string: "https://nightscout.example.com")!
+        let error = NightscoutError.httpError(status: 500, body: "Internal Server Error")
+
+        XCTAssertFalse(shouldUseT1PalAuthenticationFallback(siteURL: siteURL, error: error))
+    }
+
+    func testT1PalUnauthorizedDoesNotUseFallback() {
+        let siteURL = URL(string: "https://my.own.t1pal.com")!
+
+        XCTAssertFalse(shouldUseT1PalAuthenticationFallback(siteURL: siteURL, error: .unauthorized))
+    }
+}
