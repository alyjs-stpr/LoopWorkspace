diff --git a/NightscoutServiceKit/NightscoutService.swift b/NightscoutServiceKit/NightscoutService.swift
index 4626630..c91077f 100644
--- a/NightscoutServiceKit/NightscoutService.swift
+++ b/NightscoutServiceKit/NightscoutService.swift
@@ -109,7 +109,18 @@ public final class NightscoutService: Service {
         }
 
         let uploader = NightscoutClient(siteURL: siteURL, apiSecret: apiSecret)
-        uploader.checkAuth(completion)
+        uploader.checkAuth { error in
+            guard shouldUseT1PalAuthenticationFallback(siteURL: siteURL, error: error) else {
+                completion(error)
+                return
+            }
+
+            // T1Pal returns an HTML 500 response from both Nightscout's legacy
+            // auth-test route and authenticated read probes on otherwise healthy
+            // provisioned sites. Save the credentials and let the real uploader
+            // requests report any operational error without blocking onboarding.
+            completion(nil)
+        }
     }
 
     public func completeCreate() {
@@ -543,3 +554,15 @@ extension KeychainManager {
 }
 
 fileprivate let NightscoutAPIAccount = "NightscoutAPI"
+
+func shouldUseT1PalAuthenticationFallback(siteURL: URL, error: NightscoutError?) -> Bool {
+    guard let host = siteURL.host?.lowercased(),
+          host == "t1pal.com" || host.hasSuffix(".t1pal.com"),
+          let error = error,
+          case .httpError(let status, _) = error
+    else {
+        return false
+    }
+
+    return (500...599).contains(status)
+}
