+// MARK: - LoKey integrated meal entry (tracking only; existing Loop dosing untouched)
+//
+// Actual carbohydrates and protein are stored independently. Copying measured
+// carbohydrates into the regular Loop carb entry requires a separate user action.
+// This view does not create carb-store entries or trigger insulin delivery.
+private struct LoKeyInlineMealEntry: View {
+    @ObservedObject var data: LoKeyMealData
+    @Binding var loopCarbs: Double?
+    let loopCarbUnit: HKUnit
+    let loopDate: Date
+    let showHistory: () -> Void
+
+    @State private var meal: LoKeyMealKind = .dinner
+    @State private var actualCarbsText = ""
+    @State private var actualProteinText = ""
+    @State private var possibleDelayedRise = false
+    @State private var note = ""
+    @State private var showCopyConfirmation = false
+    @State private var didSave = false
+
+    private var measuredCarbs: Double? {
+        Double(actualCarbsText.trimmingCharacters(in: .whitespacesAndNewlines))
+    }
+
+    private var measuredProtein: Double? {
+        Double(actualProteinText.trimmingCharacters(in: .whitespacesAndNewlines))
+    }
+
+    private func valid(_ grams: Double?) -> Bool {
+        guard let grams else { return false }
+        return grams.isFinite && grams >= 0 && grams <= 500
+    }
+
+    private var canSave: Bool {
+        valid(measuredCarbs) && valid(measuredProtein)
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Label("LoKey Adaptive Meals", systemImage: "fork.knife.circle.fill")
+                    .font(.headline)
+                Spacer(minLength: 8)
+                Button("History & settings", action: showHistory)
+                    .font(.footnote)
+            }
+
+            Picker("Meal", selection: $meal) {
+                ForEach(LoKeyMealKind.allCases) { kind in
+                    Text(kind.name).tag(kind)
+                }
+            }
+
+            HStack {
+                Text("Actual carbs (g)")
+                Spacer()
+                TextField("0", text: $actualCarbsText)
+                    .keyboardType(.decimalPad)
+                    .multilineTextAlignment(.trailing)
+                    .frame(maxWidth: 92)
+                    .accessibilityLabel("Measured carbohydrates in grams")
+            }
+
+            HStack {
+                Text("Actual protein (g)")
+                Spacer()
+                TextField("0", text: $actualProteinText)
+                    .keyboardType(.decimalPad)
+                    .multilineTextAlignment(.trailing)
+                    .frame(maxWidth: 92)
+                    .accessibilityLabel("Measured protein in grams")
+            }
+
+            Text("These measured amounts are for your meal history. Protein is not added to Loop carbs automatically.")
+                .font(.caption)
+                .foregroundColor(.secondary)
+
+            Button {
+                showCopyConfirmation = true
+            } label: {
+                Label("Copy actual carbs into Loop field", systemImage: "arrow.down.doc")
+            }
+            .disabled(!valid(measuredCarbs))
+            .confirmationDialog(
+                "Use measured carbohydrates for the Loop carb entry?",
+                isPresented: $showCopyConfirmation,
+                titleVisibility: .visible
+            ) {
+                Button("Confirm carb copy") {
+                    guard let grams = measuredCarbs, valid(grams) else { return }
+                    loopCarbs = HKQuantity(unit: .gram(), doubleValue: grams).doubleValue(for: loopCarbUnit)
+                }
+                Button("Cancel", role: .cancel) {}
+            } message: {
+                Text("Only the carbohydrate value is copied. Review Loop carbs below, then use Loop's regular Continue and bolus confirmation. No insulin is delivered by copying.")
+            }
+
+            Toggle("Possible delayed rise", isOn: $possibleDelayedRise)
+            TextField("Meal notes (optional)", text: $note)
+
+            Button("Save meal observation") {
+                saveObservation()
+            }
+            .disabled(!canSave)
+
+            if didSave {
+                Label("Observation saved locally", systemImage: "checkmark.circle")
+                    .font(.footnote)
+                    .foregroundColor(.green)
+            }
+
+            Text("Loop carb quantity, absorption, predictions and insulin confirmation remain in the original Loop controls below. Saving here never doses insulin.")
+                .font(.caption)
+                .foregroundColor(.secondary)
+        }
+        .padding()
+        .background(CardBackground())
+    }
+
+    private func saveObservation() {
+        guard let carbs = measuredCarbs, let protein = measuredProtein, canSave else { return }
+        let loopGrams = loopCarbs.map {
+            HKQuantity(unit: loopCarbUnit, doubleValue: $0).doubleValue(for: .gram())
+        }
+        data.add(LoKeyMealObservation(
+            date: loopDate,
+            meal: meal,
+            carbCategory: data.classify(carbs, baseline: data.baselineCarbs[meal.rawValue]),
+            proteinCategory: data.classify(protein, baseline: data.baselineProtein[meal.rawValue]),
+            actualCarbs: carbs,
+            actualProtein: protein,
+            loopCarbsRecorded: loopGrams,
+            proteinFactor: data.proteinFactor,
+            possibleDelayedRise: possibleDelayedRise,
+            note: note.trimmingCharacters(in: .whitespacesAndNewlines)
+        ))
+        didSave = true
+        actualCarbsText = ""
+        actualProteinText = ""
+        possibleDelayedRise = false
+        note = ""
+    }
+}
