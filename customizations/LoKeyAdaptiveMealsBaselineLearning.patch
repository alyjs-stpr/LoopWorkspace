+    // Suggested usual values are median grams from up to 30 exact entries;
+    // quick estimates and Loop carb-equivalent amounts never enter training.
+    // A suggestion is offered only after 5 exact entries for this meal type.
+    private func learnedBaseline(for meal: LoKeyMealKind) -> (carbs: Double, protein: Double, count: Int)? {
+        let samples = LoKeyMealStorage.records().filter {
+            $0.meal == meal && !$0.isQuick && $0.actualCarbs != nil && $0.protein != nil
+        }.prefix(30)
+        guard samples.count >= 5 else { return nil }
+
+        let carbs = samples.compactMap { $0.actualCarbs }.sorted()
+        let proteins = samples.compactMap { $0.protein }.sorted()
+        func median(_ values: [Double]) -> Double {
+            let center = values.count / 2
+            return values.count.isMultiple(of: 2)
+                ? (values[center - 1] + values[center]) / 2
+                : values[center]
+        }
+        return (carbs: median(carbs), protein: median(proteins), count: samples.count)
+    }
 
