+/// Pure visual-coordinate transformation used by the LoKey status charts.
+/// Real date/CGM/DoseStore data is retained without modification.
+/// One hour of history occupies the same plot width as three forecast hours.
+public struct LoKeyDisplayTimeScale {
+    public let nowAnchor: Date
+
+    public init(nowAnchor: Date) {
+        self.nowAnchor = nowAnchor
+    }
+
+    public func displayDate(for actual: Date) -> Date {
+        let delta = actual.timeIntervalSince(nowAnchor)
+        return nowAnchor.addingTimeInterval(delta < 0 ? delta * 3 : delta)
+    }
+
+    public func actualDate(for displayed: Date) -> Date {
+        let delta = displayed.timeIntervalSince(nowAnchor)
+        return nowAnchor.addingTimeInterval(delta < 0 ? delta / 3 : delta)
+    }
+}
+
+/// X positions are deliberately nonlinear; descriptions and date accessors
+/// continue to report the real time. Never use this to store therapy data.
+public final class LoKeyDisplayDateAxisValue: ChartAxisValueDate {
+    private let actual: Date
+    private let scale: LoKeyDisplayTimeScale
+    private let displayFormatter: (Date) -> String
+
+    public override var date: Date { actual }
+
+    public init(date: Date,
+                scale: LoKeyDisplayTimeScale,
+                formatter: @escaping (Date) -> String,
+                labelSettings: ChartLabelSettings = ChartLabelSettings()) {
+        self.actual = date
+        self.scale = scale
+        self.displayFormatter = formatter
+        super.init(date: scale.displayDate(for: date),
+                   formatter: formatter, labelSettings: labelSettings)
+    }
+
+    public convenience init(date: Date, scale: LoKeyDisplayTimeScale,
+                            formatter: DateFormatter,
+                            labelSettings: ChartLabelSettings = ChartLabelSettings()) {
+        self.init(date: date, scale: scale,
+                  formatter: { formatter.string(from: $0) },
+                  labelSettings: labelSettings)
+    }
+
+    public override func copy(_ scalar: Double) -> ChartAxisValue {
+        let displayed = Date(timeIntervalSince1970: scalar)
+        return LoKeyDisplayDateAxisValue(
+            date: scale.actualDate(for: displayed),
+            scale: scale,
+            formatter: displayFormatter,
+            labelSettings: labelSettings
+        )
+    }
+}
+
+/// Format and place the same real date; only the on-screen x coordinate changes.
+internal func loKeyChartDateValue(
+    _ date: Date,
+    formatter: DateFormatter,
+    scale: LoKeyDisplayTimeScale?
+) -> ChartAxisValueDate {
+    guard let scale else { return ChartAxisValueDate(date: date, formatter: formatter) }
+    return LoKeyDisplayDateAxisValue(date: date, scale: scale, formatter: formatter)
+}
+
+internal func loKeyVisualPoint(
+    _ point: ChartPoint,
+    scale: LoKeyDisplayTimeScale?,
+    formatter: DateFormatter
+) -> ChartPoint {
+    guard let scale,
+          let real = (point.x as? ChartAxisValueDate)?.date else { return point }
+    return ChartPoint(x: LoKeyDisplayDateAxisValue(date: real, scale: scale,
+                                                  formatter: formatter), y: point.y)
+}
+
+open class ChartsManager {
