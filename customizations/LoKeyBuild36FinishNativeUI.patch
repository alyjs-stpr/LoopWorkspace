diff --git a/LoopUI/Views/StatusBarHUDView.swift b/LoopUI/Views/StatusBarHUDView.swift
--- a/LoopUI/Views/StatusBarHUDView.swift
+++ b/LoopUI/Views/StatusBarHUDView.swift
@@ -28,1 +28,60 @@
-    private let lokeyPumpLabel = UILabel()
+    private let lokeyPumpLabel = UILabel()
+    private var lokeyDashboardStatusRow: UIStackView?
+    private var lokeyDashboardTiles: [UIView] = []
+    private var lokeyPreviousGlucoseFont: UIFont?
+
+    // The large LoKey glucose card IS the native CGM HUD. Moving the existing
+    // views keeps glucose trends, highlights, badges and tap actions working.
+    // The small Loop and pump HUDs remain fully visible directly below it.
+    public func setLoKeyDashboardMode(_ enabled: Bool) {
+        if enabled {
+            guard lokeyDashboardStatusRow == nil else { return }
+            let tiles = containerView.arrangedSubviews
+            guard tiles.count == 3 else { return }
+            lokeyDashboardTiles = tiles
+            for tile in tiles {
+                containerView.removeArrangedSubview(tile)
+                tile.removeFromSuperview()
+            }
+            let statusRow = UIStackView(arrangedSubviews: [tiles[1], tiles[2]])
+            statusRow.axis = .horizontal
+            statusRow.distribution = .fillEqually
+            statusRow.alignment = .fill
+            statusRow.spacing = 9
+            containerView.axis = .vertical
+            containerView.alignment = .fill
+            containerView.distribution = .fill
+            containerView.spacing = 10
+            containerView.addArrangedSubview(tiles[0])
+            containerView.addArrangedSubview(statusRow)
+            lokeyDashboardStatusRow = statusRow
+
+            let glucose = cgmStatusHUD.glucoseValueHUD.glucoseLabel
+            lokeyPreviousGlucoseFont = glucose.font
+            glucose.font = .monospacedDigitSystemFont(ofSize: 48, weight: .bold)
+            glucose.adjustsFontSizeToFitWidth = true
+            glucose.minimumScaleFactor = 0.65
+        } else {
+            guard let statusRow = lokeyDashboardStatusRow,
+                  lokeyDashboardTiles.count == 3 else { return }
+            containerView.removeArrangedSubview(statusRow)
+            statusRow.removeFromSuperview()
+            containerView.removeArrangedSubview(lokeyDashboardTiles[0])
+            lokeyDashboardTiles[0].removeFromSuperview()
+            for tile in lokeyDashboardTiles {
+                if let superview = tile.superview as? UIStackView {
+                    superview.removeArrangedSubview(tile)
+                }
+                tile.removeFromSuperview()
+            }
+            containerView.axis = .horizontal
+            containerView.distribution = .fillEqually
+            containerView.spacing = adjustViewsForNarrowDisplay ? 4 : 6
+            for tile in lokeyDashboardTiles { containerView.addArrangedSubview(tile) }
+            if let previous = lokeyPreviousGlucoseFont {
+                cgmStatusHUD.glucoseValueHUD.glucoseLabel.font = previous
+            }
+            lokeyDashboardStatusRow = nil
+            lokeyDashboardTiles = []
+        }
+    }
