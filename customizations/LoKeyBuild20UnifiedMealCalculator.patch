+    // Estimate only: Loop's standard carb/bolus workflow remains authoritative.
+    // Protein may produce a later glucose rise; a single carb equivalent cannot
+    // represent the full timing of protein absorption.
+    private var calculatedLoopCarbs: Double? {
+        guard canSave,
+              let carbs = measuredCarbs, let protein = measuredProtein,
+              data.proteinFactor.isFinite,
+              data.proteinFactor >= 0 && data.proteinFactor <= 1
+        else { return nil }
+
+        let total = carbs + protein * data.proteinFactor
+        return valid(total) ? total : nil
+    }
+
+    private var appliedValueIsCurrent: Bool {
+        guard let applied = lastAppliedEquivalent,
+              let calculated = calculatedLoopCarbs,
+              let entered = loopCarbs
+        else { return false }
+        let enteredGrams = HKQuantity(unit: loopCarbUnit, doubleValue: entered).doubleValue(for: .gram())
+        return abs(applied - calculated) < 0.01 && abs(applied - enteredGrams) < 0.01
+    }
