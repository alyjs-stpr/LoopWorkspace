+                            invalidValue = true
+                            break
+                        }
+                        switch dose.type {
+                        case .basal, .tempBasal: basalUnits += units
+                        case .bolus:
+                            // Keep pump-delivered doses separate from manually
+                            // logged doses that are not confirmed by a pump.
+                            if dose.manuallyEntered {
+                                manuallyLoggedUnits += units
+                            } else {
+                                bolusUnits += units
+                                if dose.automatic == true {
+                                    automaticBolusUnits += units
+                                } else if dose.automatic == false || dose.wasProgrammedByPumpUI {
+                                    initiatedBolusUnits += units
+                                } else {
+                                    unclassifiedBolusUnits += units
