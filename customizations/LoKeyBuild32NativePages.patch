+    private final class LoKeyQuickStatsCell: UITableViewCell {
+        static let id = "LoKeyQuickStatsCell"
+        var onTarget: ((Int) -> Void)?
+        override init(style: UITableViewCell.CellStyle, reuseIdentifier: String?) {
+            super.init(style: style, reuseIdentifier: reuseIdentifier)
+            selectionStyle = .none
+            backgroundColor = .clear
+        }
+        required init?(coder: NSCoder) { fatalError("init(coder:) unavailable") }
+        @objc private func targetTapped(_ sender: UIButton) { onTarget?(sender.tag) }
+        func update(lastBolus: String, carbs: String, targetsEnabled: [Bool]) {
+            contentView.subviews.forEach { $0.removeFromSuperview() }
+            func info(_ title: String, _ value: String) -> UIView {
+                let heading = UILabel()
+                heading.text = title
+                heading.font = .preferredFont(forTextStyle: .caption1)
+                heading.textColor = .secondaryLabel
+                let amount = UILabel()
+                amount.text = value
+                amount.font = .preferredFont(forTextStyle: .headline)
+                amount.numberOfLines = 2
+                amount.adjustsFontForContentSizeCategory = true
+                let stack = UIStackView(arrangedSubviews: [heading, amount])
+                stack.axis = .vertical; stack.spacing = 6
+                stack.backgroundColor = .secondarySystemGroupedBackground
+                stack.isLayoutMarginsRelativeArrangement = true
+                stack.directionalLayoutMargins = NSDirectionalEdgeInsets(top: 16, leading: 14, bottom: 16, trailing: 12)
+                stack.layer.cornerRadius = 18
+                return stack
+            }
+            let values = UIStackView(arrangedSubviews: [info("LAST BOLUS", lastBolus), info("ACTIVE CARBS", carbs)])
+            values.axis = .horizontal; values.distribution = .fillEqually; values.spacing = 9
+            let targetTitle = UILabel()
+            targetTitle.text = "TARGETS"
+            targetTitle.textColor = .secondaryLabel
+            targetTitle.font = .preferredFont(forTextStyle: .caption1)
+            let labels = ["Pre-Meal", "Workout", "Theme Park"]
+            let modes = UIStackView()
+            modes.axis = .horizontal; modes.spacing = 7; modes.distribution = .fillEqually
+            for i in 0..<3 {
+                let button = UIButton(type: .system)
+                button.tag = i
+                button.setTitle(labels[i], for: .normal)
+                button.titleLabel?.font = .systemFont(ofSize: 12, weight: .semibold)
+                button.titleLabel?.adjustsFontSizeToFitWidth = true
+                button.backgroundColor = UIColor(red: 0.94, green: 0.91, blue: 0.99, alpha: 1)
+                button.tintColor = UIColor(red: 0.43, green: 0.18, blue: 0.79, alpha: 1)
+                button.layer.cornerRadius = 12
+                button.isEnabled = targetsEnabled.indices.contains(i) && targetsEnabled[i]
+                button.addTarget(self, action: #selector(targetTapped(_:)), for: .touchUpInside)
+                button.heightAnchor.constraint(greaterThanOrEqualToConstant: 46).isActive = true
+                modes.addArrangedSubview(button)
+            }
+            let targetStack = UIStackView(arrangedSubviews: [targetTitle, modes])
+            targetStack.axis = .vertical; targetStack.spacing = 9
+            targetStack.backgroundColor = .secondarySystemGroupedBackground
+            targetStack.isLayoutMarginsRelativeArrangement = true
+            targetStack.directionalLayoutMargins = NSDirectionalEdgeInsets(top: 12, leading: 13, bottom: 13, trailing: 13)
+            targetStack.layer.cornerRadius = 18
+            let stack = UIStackView(arrangedSubviews: [values, targetStack])
+            stack.axis = .vertical; stack.spacing = 11
+            stack.translatesAutoresizingMaskIntoConstraints = false
+            contentView.addSubview(stack)
+            NSLayoutConstraint.activate([
+                stack.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 5),
+                stack.bottomAnchor.constraint(equalTo: contentView.bottomAnchor, constant: -6),
+                stack.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 12),
+                stack.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -12)
+            ])
+        }
+    }
