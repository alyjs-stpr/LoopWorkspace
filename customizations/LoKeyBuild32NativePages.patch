+    private func loKeyInstallPages() {
+        let header = UIView(frame: CGRect(x: 0, y: 0, width: tableView.bounds.width, height: 142))
+        header.backgroundColor = .systemGroupedBackground
+        header.autoresizingMask = [.flexibleWidth]
+
+        let brand = UILabel()
+        brand.text = "LoKey LOOP"
+        brand.textColor = UIColor(red: 0.43, green: 0.18, blue: 0.79, alpha: 1)
+        brand.font = .systemFont(ofSize: 27, weight: .bold)
+
+        let loop = UILabel()
+        loop.font = .preferredFont(forTextStyle: .caption1)
+        loop.textColor = .systemGreen
+        loop.textAlignment = .right
+        loop.adjustsFontForContentSizeCategory = true
+        loKeyStatusText = loop
+
+        let age = UILabel()
+        age.font = .preferredFont(forTextStyle: .caption1)
+        age.textColor = .secondaryLabel
+        age.adjustsFontForContentSizeCategory = true
+        loKeyAgeText = age
+
+        let tabs = UISegmentedControl(items: ["DASHBOARD", "INSULIN", "POD INFO"])
+        tabs.selectedSegmentIndex = loKeyPage.rawValue
+        tabs.selectedSegmentTintColor = UIColor(red: 0.46, green: 0.19, blue: 0.79, alpha: 1)
+        tabs.setTitleTextAttributes([.foregroundColor: UIColor.white], for: .selected)
+        tabs.setTitleTextAttributes([.foregroundColor: UIColor.secondaryLabel], for: .normal)
+        tabs.addTarget(self, action: #selector(loKeyChangePage(_:)), for: .valueChanged)
+        tabs.accessibilityLabel = "LoKey main screens"
+
+        for v in [brand, loop, age, tabs] {
+            v.translatesAutoresizingMaskIntoConstraints = false
+            header.addSubview(v)
+        }
+        NSLayoutConstraint.activate([
+            brand.topAnchor.constraint(equalTo: header.topAnchor, constant: 15),
+            brand.leadingAnchor.constraint(equalTo: header.leadingAnchor, constant: 22),
+            loop.centerYAnchor.constraint(equalTo: brand.centerYAnchor),
+            loop.trailingAnchor.constraint(equalTo: header.trailingAnchor, constant: -20),
+            brand.trailingAnchor.constraint(lessThanOrEqualTo: loop.leadingAnchor, constant: -8),
+            age.topAnchor.constraint(equalTo: brand.bottomAnchor, constant: 6),
+            age.leadingAnchor.constraint(equalTo: brand.leadingAnchor),
+            tabs.topAnchor.constraint(equalTo: age.bottomAnchor, constant: 14),
+            tabs.leadingAnchor.constraint(equalTo: header.leadingAnchor, constant: 15),
+            tabs.trailingAnchor.constraint(equalTo: header.trailingAnchor, constant: -15),
+            tabs.bottomAnchor.constraint(equalTo: header.bottomAnchor, constant: -14)
+        ])
+        tableView.tableHeaderView = header
+        loKeyRefreshHeader()
+    }
+
+    private func loKeyRefreshHeader() {
+        if let last = deviceManager.loopManager.lastLoopCompleted {
+            let age = max(0, Int(Date().timeIntervalSince(last) / 60))
+            loKeyStatusText?.text = age <= 10 ? "● Loop running" : "● Loop overdue · \(age)m"
+            loKeyStatusText?.textColor = age <= 10 ? .systemGreen : .systemOrange
+        } else {
+            loKeyStatusText?.text = "● Loop waiting"
+            loKeyStatusText?.textColor = .secondaryLabel
+        }
+        loKeyAgeText?.text = "CGM " + lokeySnapshot.glucoseAge
+    }
+
+    @objc private func loKeyChangePage(_ sender: UISegmentedControl) {
+        guard let page = LoKeyPage(rawValue: sender.selectedSegmentIndex) else { return }
+        loKeyPage = page
+        loKeyRefreshHeader()
+        tableView.reloadData()
+        tableView.setContentOffset(CGPoint(x: 0, y: -tableView.adjustedContentInset.top), animated: false)
+    }
+
+    private func loKeyChartRow(at row: Int) -> ChartRow {
+        if loKeyPage == .insulin { return row == 0 ? .iob : .dose }
+        return .glucose
+    }
