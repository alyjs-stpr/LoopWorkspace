+private struct LoKeySettingsView: View {
+    let viewModel: SettingsViewModel
+
+    // Shared with the recorder; changing the screen must not reset the opt-in.
+    @AppStorage("LoKeyAdaptiveShadowEnabledV1") private var shadowEnabled = false
+    @State private var exportFiles: [URL] = []
+    @State private var showingExporter = false
+    @State private var showingEmptyExportAlert = false
+
+    var body: some View {
+        Form {
+            Section(header: Text("Adaptive Shadow")) {
+                Toggle("Record live shadow decisions", isOn: $shadowEnabled)
+                Text("Observation only. Normal Loop controls insulin delivery. Records remain on this iPhone unless you choose to export them.")
+                    .font(.footnote)
+                    .foregroundColor(.secondary)
+                Button("Export Shadow Records") { exportShadowRecords() }
+            }
+
+            Section(header: Text("Reports")) {
+                NavigationLink(destination: LoKeyReportsView(viewModel: viewModel)) {
+                    Label("Glucose reports & settings PDF", systemImage: "chart.pie")
+                }
+            }
+        }
+        .navigationTitle("LoKey Settings")
+        .navigationBarTitleDisplayMode(.inline)
+        .sheet(isPresented: $showingExporter) {
+            LoKeyReportShareSheet(items: exportFiles)
+        }
+        .alert("No shadow records yet", isPresented: $showingEmptyExportAlert) {
+            Button("OK", role: .cancel) {}
+        } message: {
+            Text("Turn on Adaptive Shadow and allow Loop to complete a cycle, then try again.")
+        }
+    }
+
+    private func exportShadowRecords() {
+        let manager = FileManager.default
+        guard let support = manager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            showingEmptyExportAlert = true
+            return
+        }
+        let directory = support.appendingPathComponent("LoKeyAdaptiveShadow", isDirectory: true)
+        let files = (try? manager.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)) ?? []
+        let records = files.filter {
+            $0.lastPathComponent.hasPrefix("adaptive-shadow-") && $0.pathExtension == "jsonl"
+        }.sorted { $0.lastPathComponent < $1.lastPathComponent }
+
+        guard !records.isEmpty else {
+            showingEmptyExportAlert = true
+            return
+        }
+        exportFiles = records
+        showingExporter = true
+    }
+}
+
