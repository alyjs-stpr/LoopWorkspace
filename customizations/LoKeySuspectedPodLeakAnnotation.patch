+            }
+            if leakFlagged {
+                let warning = UILabel()
+                warning.text = "Suspected pod leak · delivered insulin uncertain. Loop IOB is unchanged."
+                warning.font = .preferredFont(forTextStyle: .footnote)
+                warning.textColor = .systemOrange
+                warning.numberOfLines = 0
+                stack.addArrangedSubview(warning)
+            }
+            let leakButton = UIButton(type: .system)
+            leakButton.setTitle(leakFlagged ? "Review / Clear Suspected Leak" : "Report Suspected Pod Leak", for: .normal)
+            leakButton.contentHorizontalAlignment = .leading
+            leakButton.addTarget(self, action: #selector(leakTapped), for: .touchUpInside)
+            leakButton.heightAnchor.constraint(greaterThanOrEqualToConstant: 44).isActive = true
+            stack.addArrangedSubview(leakButton)
+            stack.layer.cornerRadius = 20
@@ -1808,1 +1808,3 @@
-                            age: age, expires: expires, remaining: timeRemaining)
+                            age: age, expires: expires, remaining: timeRemaining,
+                            leakFlagged: loKeyCurrentPodLeakFlagged())
+                cell.onLeakReview = { [weak self] in self?.loKeyReviewSuspectedPodLeak() }
