diff --git a/Loop/Managers/DeviceDataManager.swift b/Loop/Managers/DeviceDataManager.swift
--- a/Loop/Managers/DeviceDataManager.swift
+++ b/Loop/Managers/DeviceDataManager.swift
@@ -582,1 +582,54 @@
-    private func processCGMReadingResult(_ manager: CGMManager, readingResult: CGMReadingResult, completion: @escaping () -> Void) {
+    // The watch is bound to successful CGM storage, not the dashboard's
+    // lifecycle. It can run while LoKey is in the background when the CGM
+    // delivers readings to the app. Never changes Loop's dose or IOB data.
+    private func loKeyCheckSuspectedPodLeakAfterCGM() {
+        let defaults = UserDefaults.standard
+        guard let flaggedPodStart = defaults.object(forKey: "LoKeyLeakFlagPodStartV1") as? Date else { return }
+        let start = Date().addingTimeInterval(-21 * 60)
+        glucoseStore.getGlucoseSamples(start: start, end: nil) { result in
+            guard case .success(let samples) = result,
+                  let latest = samples.max(by: { $0.startDate < $1.startDate }),
+                  latest.startDate.timeIntervalSinceNow >= -(10 * 60),
+                  latest.startDate.timeIntervalSinceNow <= 60 else { return }
+            let glucose = latest.quantity.doubleValue(for: .milligramsPerDeciliter)
+            guard glucose.isFinite else { return }
+            let previous = samples.filter { sample in
+                let minutes = latest.startDate.timeIntervalSince(sample.startDate) / 60
+                return minutes >= 10 && minutes <= 20
+            }.max(by: { $0.startDate < $1.startDate })
+            let change = previous.map {
+                glucose - $0.quantity.doubleValue(for: .milligramsPerDeciliter)
+            }
+            let highAndRising = glucose >= 180 && (change ?? 0) >= 15
+            let veryHigh = glucose >= 250
+            guard highAndRising || veryHigh else { return }
+            // Re-check the flag to avoid an alert after the user clears it.
+            guard defaults.object(forKey: "LoKeyLeakFlagPodStartV1") as? Date != nil else { return }
+            let now = Date()
+            if let lastAlert = defaults.object(forKey: "LoKeyLeakWatchLastAlertV1") as? Date,
+               now.timeIntervalSince(lastAlert) < 30 * 60 { return }
+            defaults.set(now, forKey: "LoKeyLeakWatchLastAlertV1")
+            let trend = change.map { String(format: "%+.0f mg/dL over the last 10–20 min", $0) }
+                ?? "trend unavailable"
+            let description = String(format: "CGM %.0f mg/dL; %@.", glucose, trend)
+            var events = defaults.array(forKey: "LoKeyLeakEventHistoryV1") as? [[String: Any]] ?? []
+            events.append([
+                "timestamp": now,
+                "podActivatedAt": flaggedPodStart,
+                "event": "elevated-glucose-observed",
+                "observation": description,
+                "cgmMgDl": glucose
+            ])
+            defaults.set(Array(events.suffix(200)), forKey: "LoKeyLeakEventHistoryV1")
+            let content = UNMutableNotificationContent()
+            content.title = "LoKey · Suspected Pod Leak Watch"
+            content.body = description + " Loop may be overestimating effective IOB. Check your glucose, pod and pump-failure plan; do not assume how much insulin was absorbed."
+            content.sound = .default
+            UNUserNotificationCenter.current().add(
+                UNNotificationRequest(identifier: "lokey.leakwatch." + UUID().uuidString,
+                                      content: content, trigger: nil)
+            )
+        }
+    }
+
+    private func processCGMReadingResult(_ manager: CGMManager, readingResult: CGMReadingResult, completion: @escaping () -> Void) {
@@ -587,1 +653,4 @@
