diff --git a/Loop/View Controllers/StatusTableViewController.swift b/Loop/View Controllers/StatusTableViewController.swift
--- a/Loop/View Controllers/StatusTableViewController.swift
+++ b/Loop/View Controllers/StatusTableViewController.swift
@@ -211,1 +211,84 @@
-    private weak var loKeyAgeText: UILabel?
+    private weak var loKeyAgeText: UILabel?
+
+    // This is only an annotation of uncertain insulin absorption. It NEVER
+    // edits DoseStore, IOB, Loop's prediction, or dosing recommendations.
+    private func loKeyCurrentPodLeakFlagged() -> Bool {
+        guard let flagged = UserDefaults.standard.object(forKey: "LoKeyLeakFlagPodStartV1") as? Date else {
+            return false
+        }
+        let raw = deviceManager.pumpManagerHUDProvider?.hudViewRawState ?? [:]
+        guard let activePodStart = raw["podActivatedAt"] as? Date else {
+            // Prefer a conservative warning if pod telemetry is temporarily missing.
+            return true
+        }
+        return abs(activePodStart.timeIntervalSince(flagged)) < 60
+    }
+
+    private func loKeySyncLeakNotice() {
+        let flagged = loKeyCurrentPodLeakFlagged()
+        UserDefaults.standard.set(flagged, forKey: "LoKeyDeliveryLeakActiveV1")
+        if flagged {
+            loKeyAgeText?.textColor = .systemOrange
+        } else {
+            loKeyAgeText?.textColor = .secondaryLabel
+        }
+    }
+
+    private func loKeyStoreLeakEvent(kind: String, podStart: Date, note: String = "") {
+        var events = UserDefaults.standard.array(forKey: "LoKeyLeakEventHistoryV1") as? [[String: Any]] ?? []
+        events.append([
+            "timestamp": Date(),
+            "podActivatedAt": podStart,
+            "event": kind,
+            "observation": note,
+            "loopReportedLastBolus": lokeySnapshot.lastBolus,
+            "loopReportedIOB": lokeySnapshot.iob
+        ])
+        UserDefaults.standard.set(events, forKey: "LoKeyLeakEventHistoryV1")
+    }
+
+    private func loKeyReviewSuspectedPodLeak() {
+        let raw = deviceManager.pumpManagerHUDProvider?.hudViewRawState ?? [:]
+        guard let podStart = raw["podActivatedAt"] as? Date else {
+            let alert = UIAlertController(title: "Pod Status Unavailable",
+                message: "Cannot attach a leak report to a verified pod. Check the Pod Info screen and try again.",
+                preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "OK", style: .default))
+            present(alert, animated: true)
+            return
+        }
+        if loKeyCurrentPodLeakFlagged() {
+            let alert = UIAlertController(title: "Suspected Pod Leak Flag",
+                message: "This flag warns that reported insulin delivery may not equal absorbed insulin. Loop's dosing calculations are unchanged. Clearing it will keep the history record.",
+                preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "Keep Flag", style: .cancel))
+            alert.addAction(UIAlertAction(title: "Clear Flag", style: .default) { [weak self] _ in
+                guard let self else { return }
+                self.loKeyStoreLeakEvent(kind: "cleared", podStart: podStart)
+                UserDefaults.standard.removeObject(forKey: "LoKeyLeakFlagPodStartV1")
+                self.loKeySyncLeakNotice()
+                self.loKeyRefreshHeader()
+                self.tableView.reloadData()
+            })
+            present(alert, animated: true)
+            return
+        }
+        let alert = UIAlertController(title: "Report Suspected Pod Leak",
+            message: "Report uncertainty only. Loop will NOT subtract insulin from IOB or add a replacement dose. Check glucose, ketones and your personal backup plan if delivery may have failed.",
+            preferredStyle: .alert)
+        alert.addTextField { field in
+            field.placeholder = "What did you notice? (optional)"
+            field.autocapitalizationType = .sentences
+        }
+        alert.addAction(UIAlertAction(title: "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: "Flag This Pod", style: .default) { [weak self, weak alert] _ in
+            guard let self else { return }
+            let note = alert?.textFields?.first?.text ?? ""
+            self.loKeyStoreLeakEvent(kind: "suspected", podStart: podStart, note: note)
+            UserDefaults.standard.set(podStart, forKey: "LoKeyLeakFlagPodStartV1")
+            self.loKeySyncLeakNotice()
+            self.loKeyRefreshHeader()
+            self.tableView.reloadData()
+        })
+        present(alert, animated: true)
+    }
@@ -270,1 +270,5 @@
-        loKeyAgeText?.text = "CGM " + lokeySnapshot.glucoseAge
+        loKeyAgeText?.text = "CGM " + lokeySnapshot.glucoseAge
+        loKeySyncLeakNotice()
+        if loKeyCurrentPodLeakFlagged() {
+            loKeyAgeText?.text = "CGM " + lokeySnapshot.glucoseAge + " · POD LEAK SUSPECTED"
+        }
