+    // Preserve access to the actual native safety HUD whenever the pump,
+    // CGM, or Loop reports a problem. Routine status is shown by the
+    // approved compact header and Insulin/Pod Info pages instead.
+    private var loKeyNeedsNativeSafetyHUD: Bool {
+        if deviceManager.cgmStatusHighlight != nil ||
+           deviceManager.cgmStatusBadge != nil ||
+           deviceManager.pumpStatusHighlight != nil ||
+           deviceManager.pumpStatusBadge != nil ||
+           deviceManager.isGlucoseValueStale {
+            return true
+        }
+        guard let lastLoop = deviceManager.loopManager.lastLoopCompleted else { return true }
+        return Date().timeIntervalSince(lastLoop) > 10 * 60
+    }
