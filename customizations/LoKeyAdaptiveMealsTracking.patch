+// MARK: - LoKey Adaptive Meals: observation-only companion to carb entry.
+// Intentionally independent of CarbStore, bolus recommendations and insulin dosing.
+
+private enum LoKeyMealKind: Int, CaseIterable, Identifiable, Codable {
+    case breakfast, lunch, dinner, snack
+    var id: Int { rawValue }
+    var name: String {
+        switch self {
+        case .breakfast: return "Breakfast"
+        case .lunch: return "Lunch"
+        case .dinner: return "Dinner"
+        case .snack: return "Snack"
+        }
+    }
+}
+
+private struct LoKeyMealObservation: Codable, Identifiable {
+    var id = UUID()
+    var date: Date
+    var meal: LoKeyMealKind
+    var carbCategory: Int
+    var proteinCategory: Int
+    // Absent for quick announcements: categories are never treated as measured grams.
+    var actualCarbs: Double?
+    var actualProtein: Double?
+    var loopCarbsRecorded: Double?
+    var proteinFactor: Double
+    var possibleDelayedRise: Bool
+    var note: String
+}
+
+private final class LoKeyMealData: ObservableObject {
+    private static let carbKey = "LoKeyMealBaselineCarbsV1"
+    private static let proteinKey = "LoKeyMealBaselineProteinV1"
+    private static let factorKey = "LoKeyMealProteinFactorV1"
+    private static let historyKey = "LoKeyMealObservationsV1"
+
+    @Published var baselineCarbs: [Double] {
+        didSet { persist(baselineCarbs, key: Self.carbKey) }
+    }
+    @Published var baselineProtein: [Double] {
+        didSet { persist(baselineProtein, key: Self.proteinKey) }
+    }
+    @Published var history: [LoKeyMealObservation] {
+        didSet { persist(history, key: Self.historyKey) }
+    }
+    @Published var proteinFactor: Double {
+        didSet { UserDefaults.standard.set(proteinFactor, forKey: Self.factorKey) }
+    }
+
+    init() {
+        let defaults = UserDefaults.standard
+        let c = defaults.data(forKey: Self.carbKey).flatMap { try? JSONDecoder().decode([Double].self, from: $0) }
+        let p = defaults.data(forKey: Self.proteinKey).flatMap { try? JSONDecoder().decode([Double].self, from: $0) }
+        let h = defaults.data(forKey: Self.historyKey).flatMap { try? JSONDecoder().decode([LoKeyMealObservation].self, from: $0) }
+        baselineCarbs = c?.count == 4 && c!.allSatisfy({ $0.isFinite && $0 > 0 && $0 <= 500 }) ? c! : [30, 45, 70, 30]
+        baselineProtein = p?.count == 4 && p!.allSatisfy({ $0.isFinite && $0 > 0 && $0 <= 500 }) ? p! : [15, 30, 45, 10]
+        history = h ?? []
+        proteinFactor = defaults.object(forKey: Self.factorKey) == nil ? 0.60 : min(1, max(0, defaults.double(forKey: Self.factorKey)))
+    }
+
+    func classify(_ amount: Double, baseline: Double) -> Int {
+        if amount < baseline * 0.75 { return 0 }
+        if amount > baseline * 1.25 { return 2 }
+        return 1
+    }
+
+    func add(_ entry: LoKeyMealObservation) { history.insert(entry, at: 0) }
+    func delete(_ ids: Set<UUID>) { history.removeAll { ids.contains($0.id) } }
+
+    private func persist<T: Encodable>(_ value: T, key: String) {
+        if let bytes = try? JSONEncoder().encode(value) {
+            UserDefaults.standard.set(bytes, forKey: key)
+        }
+    }
+}
+
+private struct LoKeyMealTrackingView: View {
+    @Environment(\.dismiss) private var dismiss
+    @ObservedObject var data: LoKeyMealData
+
+    @State private var meal: LoKeyMealKind = .dinner
+    @State private var when = Date()
+    @State private var detailed = false
+    @State private var carbCategory = 1
+    @State private var proteinCategory = 1
+    @State private var carbs = ""
+    @State private var protein = ""
+    @State private var loopRecorded = ""
+    @State private var delayed = false
+    @State private var note = ""
+    @State private var showBaselines = false
+    @State private var didSave = false
+
+    private var typicalCarbs: Double { data.baselineCarbs[meal.rawValue] }
+    private var typicalProtein: Double { data.baselineProtein[meal.rawValue] }
+    private var parsedCarbs: Double? { Double(carbs) }
+    private var parsedProtein: Double? { Double(protein) }
+    private var parsedLoop: Double? { Double(loopRecorded) }
+
+    private func allowed(_ amount: Double?) -> Bool {
+        guard let amount else { return false }
+        return amount.isFinite && amount >= 0 && amount <= 500
+    }
+
+    private var valid: Bool {
+        (loopRecorded.isEmpty || allowed(parsedLoop)) &&
+        (!detailed || (allowed(parsedCarbs) && allowed(parsedProtein)))
+    }
+
+    private var chosenCarbs: Int {
+        detailed ? data.classify(parsedCarbs ?? 0, baseline: typicalCarbs) : carbCategory
+    }
+    private var chosenProtein: Int {
+        detailed ? data.classify(parsedProtein ?? 0, baseline: typicalProtein) : proteinCategory
+    }
+
+    private var proteinLabels: [String] { ["Low", "Moderate", "High"] }
+    private var carbLabels: [String] { ["Low", "Usual", "High"] }
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section(header: Text("Meal")) {
+                    Picker("Meal", selection: $meal) {
+                        ForEach(LoKeyMealKind.allCases) { item in
+                            Text(item.name).tag(item)
+                        }
+                    }
+                    DatePicker("When", selection: $when, displayedComponents: [.date, .hourAndMinute])
+                    Text("Your baseline: \(Int(typicalCarbs)) g actual carbs · \(Int(typicalProtein)) g protein")
+                        .font(.footnote).foregroundColor(.secondary)
+                    Button("Edit Baselines & Protein Factor") { showBaselines = true }
+                }
+
+                Section(header: Text("Announcement")) {
+                    Toggle("Detailed grams", isOn: $detailed)
+                    if detailed {
+                        HStack {
+                            Text("Actual carbs (g)")
+                            Spacer()
+                            TextField("g", text: $carbs).keyboardType(.decimalPad)
+                                .multilineTextAlignment(.trailing)
+                        }
+                        HStack {
+                            Text("Actual protein (g)")
+                            Spacer()
+                            TextField("g", text: $protein).keyboardType(.decimalPad)
+                                .multilineTextAlignment(.trailing)
+                        }
+                        if allowed(parsedCarbs) && allowed(parsedProtein) {
+                            Text("\(carbLabels[chosenCarbs]) carbs · \(proteinLabels[chosenProtein]) protein")
+                            Text("Observation only: \(Int(parsedCarbs!)) g carbs + \(Int(parsedProtein! * data.proteinFactor)) g protein equivalents (\(Int(data.proteinFactor * 100))%).")
+                                .font(.caption).foregroundColor(.secondary)
+                        }
+                    } else {
+                        Picker("Carbs", selection: $carbCategory) {
+                            ForEach(0..<3, id: \.self) { index in
+                                Text(carbLabels[index]).tag(index)
+                            }
+                        }.pickerStyle(.segmented)
+                        Picker("Protein", selection: $proteinCategory) {
+                            ForEach(0..<3, id: \.self) { index in
+                                Text(proteinLabels[index]).tag(index)
+                            }
+                        }.pickerStyle(.segmented)
+                        Text("Usual carbs: \(range(typicalCarbs)) g; moderate protein: \(range(typicalProtein)) g. Categories are estimates, not exact grams.")
+                            .font(.caption).foregroundColor(.secondary)
+                    }
+                }
+
+                Section(header: Text("Observations")) {
+                    Toggle("Possible delayed rise", isOn: $delayed)
+                    TextField("Meal notes (optional)", text: $note)
+                    HStack {
+                        Text("Loop carbs entered (optional)")
+                        Spacer()
+                        TextField("g", text: $loopRecorded).keyboardType(.decimalPad)
+                            .multilineTextAlignment(.trailing)
+                    }
+                    Text("This documents a separate existing Loop carb entry; it never creates or changes one.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+
+                Section {
+                    Button("Save Meal Observation") { save() }.disabled(!valid)
+                    if didSave {
+                        Label("Saved locally; dosing unchanged", systemImage: "checkmark.circle.fill")
+                            .foregroundColor(.green)
+                    }
+                    Text("Logging is separate from insulin dosing, Loop carbs, predictions and pump settings.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+
+                Section(header: Text("Recent observations")) {
+                    if data.history.isEmpty {
+                        Text("No observations yet").foregroundColor(.secondary)
+                    }
+                    ForEach(data.history.prefix(20)) { record in
+                        VStack(alignment: .leading, spacing: 3) {
+                            Text("\(record.meal.name) · \(record.date.formatted(date: .abbreviated, time: .shortened))")
+                                .font(.subheadline).bold()
+                            if let c = record.actualCarbs, let p = record.actualProtein {
+                                Text("\(Int(c)) g actual carbs · \(Int(p)) g protein")
+                            } else {
+                                Text("\(carbLabels[record.carbCategory]) carbs · \(proteinLabels[record.proteinCategory]) protein (category only)")
+                            }
+                            if record.possibleDelayedRise {
+                                Text("Possible delayed rise").foregroundColor(.secondary)
+                            }
+                            if !record.note.isEmpty {
+                                Text(record.note).foregroundColor(.secondary)
+                            }
+                        }.font(.footnote)
+                    }
+                    .onDelete(perform: delete)
+                    Text("History is stored on this device only, not in HealthKit or Nightscout.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+            }
+            .navigationTitle("Adaptive Meals")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarLeading) {
+                    Button("Done") { dismiss() }
+                }
+            }
+            .sheet(isPresented: $showBaselines) {
+                LoKeyMealBaselineEditor(data: data)
+            }
+        }
+    }
+
+    private func range(_ baseline: Double) -> String {
+        String(format: "%.1f–%.1f", baseline * 0.75, baseline * 1.25)
+    }
+
+    private func save() {
+        guard valid else { return }
+        data.add(LoKeyMealObservation(
+            date: when, meal: meal,
+            carbCategory: chosenCarbs, proteinCategory: chosenProtein,
+            actualCarbs: detailed ? parsedCarbs : nil,
+            actualProtein: detailed ? parsedProtein : nil,
+            loopCarbsRecorded: loopRecorded.isEmpty ? nil : parsedLoop,
+            proteinFactor: data.proteinFactor,
+            possibleDelayedRise: delayed,
+            note: note.trimmingCharacters(in: .whitespacesAndNewlines)
+        ))
+        didSave = true
+        carbs = ""; protein = ""; loopRecorded = ""; note = ""; delayed = false
+        when = Date()
+    }
+
+    private func delete(at offsets: IndexSet) {
+        let recent = Array(data.history.prefix(20))
+        let ids = Set(offsets.compactMap { recent.indices.contains($0) ? recent[$0].id : nil })
+        data.delete(ids)
+    }
+}
+
+private struct LoKeyMealBaselineEditor: View {
+    @Environment(\.dismiss) private var dismiss
+    @ObservedObject var data: LoKeyMealData
+    @State private var carbs: [String]
+    @State private var protein: [String]
+    @State private var factor: Double
+
+    init(data: LoKeyMealData) {
+        self.data = data
+        _carbs = State(initialValue: data.baselineCarbs.map { String(format: "%.0f", $0) })
+        _protein = State(initialValue: data.baselineProtein.map { String(format: "%.0f", $0) })
+        _factor = State(initialValue: data.proteinFactor)
+    }
+
+    private var valid: Bool {
+        carbs.count == 4 && protein.count == 4 &&
+        zip(carbs, protein).allSatisfy { c, p in
+            guard let c = Double(c), let p = Double(p) else { return false }
+            return c.isFinite && p.isFinite && c > 0 && p > 0 && c <= 500 && p <= 500
+        }
+    }
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section(header: Text("Personal meal baselines"),
+                        footer: Text("Low: less than 75%. Usual carbs / moderate protein: 75–125%. High: above 125%. Each nutrient has a separate baseline. These are descriptions, not insulin targets.")) {
+                    ForEach(LoKeyMealKind.allCases) { kind in
+                        VStack(alignment: .leading, spacing: 8) {
+                            Text(kind.name).font(.headline)
+                            HStack {
+                                Text("Actual carbs (g)")
+                                Spacer()
+                                TextField("g", text: $carbs[kind.rawValue])
+                                    .keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                            }
+                            HStack {
+                                Text("Protein (g)")
+                                Spacer()
+                                TextField("g", text: $protein[kind.rawValue])
+                                    .keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                            }
+                        }
+                    }
+                }
+                Section(header: Text("Existing protein convention"),
+                        footer: Text("Only used for observational calculations. Does not modify Loop dosing or carb entries.")) {
+                    HStack {
+                        Text("Protein-equivalent factor")
+                        Spacer()
+                        Text("\(Int(factor * 100))%").bold()
+                    }
+                    Slider(value: $factor, in: 0...1, step: 0.05)
+                }
+                Section {
+                    Button("Save Baselines") { save() }.disabled(!valid)
+                }
+            }
+            .navigationTitle("Meal Baselines")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarLeading) {
+                    Button("Cancel") { dismiss() }
+                }
+            }
+        }
+    }
+
+    private func save() {
+        guard valid else { return }
+        data.baselineCarbs = carbs.compactMap(Double.init)
+        data.baselineProtein = protein.compactMap(Double.init)
+        data.proteinFactor = factor
+        dismiss()
+    }
+}
