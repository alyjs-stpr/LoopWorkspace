+            }
+            .confirmationDialog("Pause Theme Park targets?", isPresented: $confirmPause) {
+                Button("Pause Targets") { pause(); dismiss() }
+            } message: {
+                Text("Loop will return to its normal target; insulin delivery continues.")
+            }
+            .confirmationDialog("End Theme Park Mode?", isPresented: $confirmEnd) {
