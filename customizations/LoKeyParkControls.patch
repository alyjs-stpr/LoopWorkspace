+private struct LoKeyThemeParkView: View {
+    @Environment(\.dismiss) private var dismiss
+    @State private var low: String
+    @State private var high: String
+    @State private var until: Date
+    @State private var confirmPause = false
+    @State private var confirmEnd = false
+    let active: Bool
+    let paused: Bool
+    let canActivate: Bool
+    let minAllowed: Double
+    let start: (Double, Double, Date) -> Bool
+    let pause: () -> Void
+    let stop: () -> Void
+    let announceMeal: () -> Void
+
+    init(active: Bool, paused: Bool, canActivate: Bool, minAllowed: Double,
+         low: Double?, high: Double?, until: Date?,
+         start: @escaping (Double, Double, Date) -> Bool,
+         pause: @escaping () -> Void, stop: @escaping () -> Void,
+         announceMeal: @escaping () -> Void) {
+        self.active = active
+        self.paused = paused
+        self.canActivate = canActivate
+        self.minAllowed = minAllowed
+        self.start = start
+        self.pause = pause
+        self.stop = stop
+        self.announceMeal = announceMeal
+        _low = State(initialValue: low.map { String(Int($0)) } ?? "")
+        _high = State(initialValue: high.map { String(Int($0)) } ?? "")
+        _until = State(initialValue: until ?? Date().addingTimeInterval(8 * 3600))
+    }
+
+    private var validRange: (Double, Double)? {
+        guard let a = Double(low), let b = Double(high),
+              a.isFinite, b.isFinite, a >= minAllowed, b <= 250, a <= b else { return nil }
+        return (a, b)
+    }
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section {
+                    HStack {
+                        Label(active ? "Active" : (paused ? "Paused" : "Ready"),
+                              systemImage: active ? "checkmark.circle.fill" : "pause.circle")
+                            .font(.headline)
+                        Spacer()
+                        Text(until.formatted(date: .omitted, time: .shortened))
+                            .foregroundColor(.secondary)
+                    }
+                    if paused {
+                        Text("Normal Loop targets are active. Insulin delivery is not paused.")
+                            .font(.footnote).foregroundColor(.secondary)
+                    }
+                }
+                Section(header: Text("Park target · mg/dL")) {
+                    HStack {
+                        Text("Minimum")
+                        Spacer()
+                        TextField("Required", text: $low)
+                            .keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                    }
+                    HStack {
+                        Text("Maximum")
+                        Spacer()
+                        TextField("Required", text: $high)
+                            .keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                    }
+                    Text("Allowed: \(Int(ceil(minAllowed)))–250 mg/dL.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+                Section(header: Text("Park hours")) {
+                    DatePicker("End time", selection: $until,
+                               in: Date().addingTimeInterval(15 * 60)...Date().addingTimeInterval(24 * 3600),
+                               displayedComponents: [.date, .hourAndMinute])
+                }
+                Section {
+                    Button(active ? "Update Park Targets" : (paused ? "Resume Park Targets" : "Start Theme Park Mode")) {
+                        guard let (a, b) = validRange else { return }
+                        if start(a, b, until) { dismiss() }
+                    }
+                    .disabled(validRange == nil || !canActivate ||
+                              until <= Date().addingTimeInterval(14 * 60))
+                    if active {
+                        Button("Pause Park Targets") { confirmPause = true }
+                    }
+                    Button("Announce Meal") { announceMeal() }
+                    if active || paused {
+                        Button("End Theme Park Mode", role: .destructive) { confirmEnd = true }
+                    }
+                }
+                if !canActivate {
+                    Section {
+                        Text("Another temporary target is active. End it before starting or resuming Theme Park targets.")
+                            .font(.footnote).foregroundColor(.secondary)
+                    }
+                }
+                Section {
+                    Text("Pausing targets does not suspend insulin. Announced meals still affect Loop predictions and can trigger automatic insulin.")
+                        .font(.footnote).foregroundColor(.secondary)
