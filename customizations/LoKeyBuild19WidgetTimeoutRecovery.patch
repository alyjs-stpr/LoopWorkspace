+    // WidgetKit can stop drawing the extension if a provider never calls
+    // completion. Guard all paths and avoid completing a request twice when
+    // the cache is slow and a timeout fallback has already been delivered.
+    private final class EntryCompletion: @unchecked Sendable {
+        private let lock = NSLock()
+        private var delivered = false
+        private let handler: (StatusWidgetTimelimeEntry) -> Void
+
+        init(_ handler: @escaping (StatusWidgetTimelimeEntry) -> Void) {
+            self.handler = handler
+        }
+
+        func finish(_ entry: StatusWidgetTimelimeEntry) {
+            lock.lock()
+            let shouldDeliver = !delivered
+            delivered = true
+            lock.unlock()
+            if shouldDeliver {
+                handler(entry)
+            }
+        }
+    }
+
+    private static func unavailableEntry() -> StatusWidgetTimelimeEntry {
+        StatusWidgetTimelimeEntry(
+            date: Date(), contextUpdatedAt: .distantPast,
+            lastLoopCompleted: nil, closeLoop: false,
+            currentGlucose: nil, glucoseFetchedAt: nil,
+            delta: nil, unit: nil, sensor: nil, pumpHighlight: nil,
+            netBasal: nil, eventualGlucose: nil,
+            preMealPresetAllowed: false, preMealPresetActive: false,
+            customPresetActive: false
+        )
+    }
+
