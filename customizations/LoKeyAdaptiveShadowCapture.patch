+// Native background-capable, READ-ONLY shadow recorder. Does not touch
+// schedule overrides, dosing recommendations, or any PumpManager command.
+private final class LoKeyAdaptiveShadowRecorder {
+    private let queue = DispatchQueue(label: "com.lokey.adaptive.shadow.files", qos: .utility)
+    private let fileManager = FileManager.default
+    private let folderName = "LoKeyAdaptiveShadow"
+
+    private func folder() -> URL? {
+        guard let base = fileManager.urls(for: .applicationSupportDirectory,
+                                          in: .userDomainMask).first else { return nil }
+        var folder = base.appendingPathComponent(folderName, isDirectory: true)
+        do {
+            try fileManager.createDirectory(at: folder, withIntermediateDirectories: true)
+            var resources = URLResourceValues()
+            resources.isExcludedFromBackup = true
+            try? folder.setResourceValues(resources)
+            return folder
+        } catch { return nil }
+    }
+
+    func record(_ snapshot: LoKeyAdaptive.Snapshot) {
+        let result = LoKeyAdaptive.Controller().evaluate(snapshot)
+        let cycle = LoKeyAdaptive.RecordedCycle(snapshot: snapshot, evaluation: result)
+        queue.async { [self] in
+            guard let folder = folder() else { return }
+            let formatter = DateFormatter()
+            formatter.dateFormat = "yyyy-MM-dd"
+            formatter.timeZone = TimeZone(secondsFromGMT: 0)
+            formatter.locale = Locale(identifier: "en_US_POSIX")
+            let filename = "adaptive-shadow-" + formatter.string(from: snapshot.observedAt) + ".jsonl"
+            let url = folder.appendingPathComponent(filename)
+            let encoder = JSONEncoder()
+            encoder.dateEncodingStrategy = .iso8601
+            encoder.outputFormatting = [.sortedKeys]
+            encoder.nonConformingFloatEncodingStrategy =
+                .convertToString(positiveInfinity: "Infinity",
+                                 negativeInfinity: "-Infinity", nan: "NaN")
+            guard var encoded = try? encoder.encode(cycle) else { return }
+            encoded.append(0x0A)
+            if !fileManager.fileExists(atPath: url.path) {
+                _ = fileManager.createFile(
+                    atPath: url.path, contents: nil,
+                    attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication]
+                )
+            }
+            if let handle = try? FileHandle(forWritingTo: url) {
+                handle.seekToEndOfFile()
+                handle.write(encoded)
+                handle.closeFile()
+            }
+            // Local-only, excluded from backup, and bounded to the last 14 days.
+            if let files = try? fileManager.contentsOfDirectory(
+                at: folder, includingPropertiesForKeys: [.contentModificationDateKey]
+            ) {
+                let oldestAllowed = Date().addingTimeInterval(-14 * 24 * 3600)
+                for file in files where file.lastPathComponent.hasPrefix("adaptive-shadow-")
+                    && file.pathExtension == "jsonl" {
+                    if let values = try? file.resourceValues(forKeys: [.contentModificationDateKey]),
+                       let modified = values.contentModificationDate, modified < oldestAllowed {
+                        try? fileManager.removeItem(at: file)
+                    }
+                }
+            }
+        }
+    }
+
+    func filesForSharing() -> [URL] {
+        queue.sync {
+            guard let folder = folder(),
+                  let urls = try? fileManager.contentsOfDirectory(
+                    at: folder, includingPropertiesForKeys: nil
+                  ) else { return [] }
+            return urls.filter {
+                $0.lastPathComponent.hasPrefix("adaptive-shadow-") && $0.pathExtension == "jsonl"
+            }.sorted(by: { $0.lastPathComponent < $1.lastPathComponent })
+        }
+    }
+}
+
+extension DeviceDataManager {
+    func loKeyAdaptiveShadowFilesForExport() -> [URL] {
+        loKeyAdaptiveShadowRecorder.filesForSharing()
+    }
+
+    // LoopCompleted is emitted for successful normal Loop cycles, including
+    // background cycles. iOS does not guarantee continued background execution.
+    fileprivate func loKeyCaptureAdaptiveShadow() {
+        guard UserDefaults.standard.bool(forKey: "LoKeyAdaptiveShadowEnabledV1") else { return }
+        let at = Date()
+        let latest = glucoseStore.latestGlucose
+        let glucose = latest.map {
+            LoKeyAdaptive.Reading(timestamp: $0.startDate,
+                                  glucoseMgDl: $0.quantity.doubleValue(for: .milligramsPerDeciliter))
+        }
+        let pumpAvailable = pumpManager != nil
+        let deliveryUncertain = pumpManager?.status.deliveryIsUncertain ?? true
+        let certainty: LoKeyAdaptive.DeliveryCertainty =
+            !pumpAvailable ? .pumpDisconnected : (deliveryUncertain ? .uncertain : .confirmed)
+        let automaticEnabled = automaticDosingStatus.automaticDosingEnabled
+        // Recent pump reconciliation data is only a *proxy* for reliable data.
+        // It does not establish delivery certainty and is NEVER used to authorize dosing.
+        let lastPumpData = doseStore.lastAddedPumpData
+        let recentPumpData = at.timeIntervalSince(lastPumpData) >= 0
+            && at.timeIntervalSince(lastPumpData) <= 20 * 60
+        loopManager.getLoopState { [weak self] manager, state in
+            guard let self else { return }
+            let parkID = UUID(uuidString: "B2717255-F306-4B52-93DC-D416A93E4BE5")!
+            let override = manager.settings.scheduleOverride
+            let parkActive: Bool
+            if let override, override.isActive(at: at),
+               case .preset(let preset) = override.context {
+                parkActive = preset.id == parkID
+            } else {
+                parkActive = false
+            }
+            let range = parkActive ? override?.settings.targetRange : nil
+            let low = range?.lowerBound.doubleValue(for: .milligramsPerDeciliter) ?? 0
+            let high = range?.upperBound.doubleValue(for: .milligramsPerDeciliter) ?? 0
+            let predictions = (state.predictedGlucoseIncludingPendingInsulin ?? []).map {
+                LoKeyAdaptive.Reading(timestamp: $0.startDate,
+                                      glucoseMgDl: $0.quantity.doubleValue(for: .milligramsPerDeciliter))
+            }
+            let iob = state.insulinOnBoard?.value
+            let cob = state.carbsOnBoard?.quantity.doubleValue(for: .gram())
+            let recommendedBolus = state.recommendedAutomaticDose?.recommendation.bolusUnits
+            let lastSuccess = state.error == nil ? manager.lastLoopCompleted : nil
+            self.doseStore.getNormalizedDoseEntries(
+                start: at.addingTimeInterval(-3 * 3600), end: at
+            ) { [weak self] response in
+                guard let self else { return }
+                let nativeEvents: [DoseEntry]
+                let dosesLoaded: Bool
+                switch response {
+                case .success(let entries):
+                    nativeEvents = entries
+                    dosesLoaded = true
+                case .failure:
+                    nativeEvents = []
+                    dosesLoaded = false
+                }
+                let doseEvents = nativeEvents.map {
+                    LoKeyAdaptive.DoseEvent(
+                        timestamp: $0.startDate,
+                        type: String(describing: $0.type),
+                        deliveredUnits: $0.deliveredUnits,
+                        programmedUnits: $0.programmedUnits
+                    )
+                }
+                let snapshot = LoKeyAdaptive.Snapshot(
+                    observedAt: at,
+                    parkModeActive: parkActive,
+                    automaticDosingEnabled: automaticEnabled,
+                    target: .init(lowMgDl: low, highMgDl: high),
+                    latestGlucose: glucose,
+                    loopCompletedAt: lastSuccess,
+                    predictedGlucose: predictions,
+                    recordedIOBUnits: iob,
+                    insulinHistoryReconciled: recentPumpData && dosesLoaded && !deliveryUncertain,
+                    deliveryCertainty: certainty,
+                    carbsOnBoardGrams: cob,
+                    recommendedAutomaticBolusUnits: recommendedBolus,
+                    recordedDoseEvents: doseEvents
+                )
+                self.loKeyAdaptiveShadowRecorder.record(snapshot)
+            }
+        }
+    }
+}
