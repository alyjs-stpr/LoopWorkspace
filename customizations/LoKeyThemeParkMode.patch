@@ -380,1 +380,8 @@
-        targetsItem.menu = UIMenu(children: [preMealAction, workoutAction])
+        let activePark = activeParkOverride
+        let parkAction = UIAction(
+            title: activePark.map { "🎢 Theme Park · until " + DateFormatter.localizedString(from: $0.scheduledEndDate, dateStyle: .none, timeStyle: .short) } ?? "🎢 Theme Park Mode",
+            image: UIImage(systemName: "ticket"),
+            attributes: onboardingManager.isComplete ? [] : [.disabled],
+            state: activePark == nil ? .off : .on
+        ) { [weak self] _ in self?.presentParkMode() }
+        targetsItem.menu = UIMenu(children: [preMealAction, workoutAction, parkAction])
@@ -1575,3 +1575,51 @@
-    @IBAction func toggleWorkoutMode(_ sender: UIBarButtonItem) {
-        presentCustomPresets(confirm: false)
-    }
+    @IBAction func toggleWorkoutMode(_ sender: UIBarButtonItem) {
+        presentCustomPresets(confirm: false)
+    }
+
+    private static let parkID = UUID(uuidString: "B2717255-F306-4B52-93DC-D416A93E4BE5")!
+
+    private var activeParkOverride: TemporaryScheduleOverride? {
+        guard let item = deviceManager.loopManager.settings.scheduleOverride,
+              item.isActive(at: Date()),
+              case .preset(let preset) = item.context,
+              preset.id == Self.parkID else { return nil }
+        return item
+    }
+
+    @objc private func presentParkMode() {
+        let item = activeParkOverride
+        let prefs = UserDefaults.standard
+        let suspend = deviceManager.loopManager.settings.suspendThreshold?.quantity.doubleValue(for: .milligramsPerDeciliter) ?? 0
+        let minAllowed = max(Guardrail.correctionRange.absoluteBounds.lowerBound.doubleValue(for: .milligramsPerDeciliter), suspend)
+        let panel = LoKeyThemeParkView(
+            active: item != nil, minAllowed: minAllowed,
+            low: item?.settings.targetRange?.lowerBound.doubleValue(for: .milligramsPerDeciliter) ?? (prefs.object(forKey: "LoKeyParkLowV1") as? Double),
+            high: item?.settings.targetRange?.upperBound.doubleValue(for: .milligramsPerDeciliter) ?? (prefs.object(forKey: "LoKeyParkHighV1") as? Double),
+            until: item?.scheduledEndDate,
+            start: { [weak self] a, b, end in
+                guard let self else { return }
+                let now = Date()
+                let seconds = end.timeIntervalSince(now)
+                guard seconds >= 15 * 60, seconds <= 24 * 3600,
+                      a >= minAllowed, b <= 250, a <= b else { return }
+                let settings = TemporaryScheduleOverrideSettings(
+                    unit: .milligramsPerDeciliter, targetRange: DoubleRange(minValue: a, maxValue: b))
+                let preset = TemporaryScheduleOverridePreset(
+                    id: Self.parkID, symbol: "🎢", name: "Theme Park",
+                    settings: settings, duration: .finite(seconds))
+                prefs.set(a, forKey: "LoKeyParkLowV1")
+                prefs.set(b, forKey: "LoKeyParkHighV1")
+                self.deviceManager.loopManager.mutateSettings { settings in
+                    settings.scheduleOverride = preset.createOverride(enactTrigger: .local, beginningAt: now)
+                }
+            },
+            stop: { [weak self] in
+                guard let self, self.activeParkOverride != nil else { return }
+                self.deviceManager.loopManager.mutateSettings { settings in
+                    guard case .preset(let preset)? = settings.scheduleOverride?.context,
+                          preset.id == Self.parkID else { return }
+                    settings.clearOverride()
+                }
+            })
+        present(UIHostingController(rootView: panel), animated: true)
+    }
