-final class StatusTableViewController: LoopChartsTableViewController {
+private struct LoKeyThemeParkView: View {
+    @Environment(\.dismiss) private var dismiss
+    @State private var low: String
+    @State private var high: String
+    @State private var until: Date
+    let active: Bool
+    let minAllowed: Double
+    let start: (Double, Double, Date) -> Void
+    let stop: () -> Void
+
+    init(active: Bool, minAllowed: Double, low: Double?, high: Double?, until: Date?,
+         start: @escaping (Double, Double, Date) -> Void, stop: @escaping () -> Void) {
+        self.active = active
+        self.minAllowed = minAllowed
+        self.start = start
+        self.stop = stop
+        _low = State(initialValue: low.map { String(Int($0)) } ?? "")
+        _high = State(initialValue: high.map { String(Int($0)) } ?? "")
+        _until = State(initialValue: until ?? Date().addingTimeInterval(8 * 3600))
+    }
+
+    private var validRange: (Double, Double)? {
+        guard let a = Double(low), let b = Double(high),
+              a.isFinite, b.isFinite, a >= minAllowed, b <= 250, a <= b else { return nil }
+        return (a, b)
+    }
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section(header: Text("Park glucose target (mg/dL)")) {
+                    HStack {
+                        Text("Minimum")
+                        Spacer()
+                        TextField("Required", text: $low).keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                    }
+                    HStack {
+                        Text("Maximum")
+                        Spacer()
+                        TextField("Required", text: $high).keyboardType(.decimalPad).multilineTextAlignment(.trailing)
+                    }
+                    Text("Allowed: \(Int(ceil(minAllowed)))–250 mg/dL. Separate from Workout Mode.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+                Section(header: Text("Park hours")) {
+                    DatePicker("Expected end", selection: $until,
+                               in: Date().addingTimeInterval(15 * 60)...Date().addingTimeInterval(24 * 3600),
+                               displayedComponents: [.date, .hourAndMinute])
+                    Text("The Loop target override expires at this time, even if the app is closed.")
+                        .font(.caption).foregroundColor(.secondary)
+                }
+                Section {
+                    Button(active ? "Update Park Mode" : "Start Park Mode") {
+                        guard let (a, b) = validRange else { return }
+                        start(a, b, until)
+                        dismiss()
+                    }
+                    .disabled(validRange == nil || until <= Date().addingTimeInterval(14 * 60))
+                    if active {
+                        Button("End Early", role: .destructive) { stop(); dismiss() }
+                    }
+                }
+                Section {
+                    Text("Announced meals influence Loop predictions and may trigger automatic insulin delivery even without a manual bolus. A higher target does not suspend insulin.")
+                        .font(.footnote).foregroundColor(.secondary)
+                }
+            }
+            .navigationTitle("🎢 Theme Park Mode")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("Done") { dismiss() } } }
+        }
+    }
+}
+
+final class StatusTableViewController: LoopChartsTableViewController {
